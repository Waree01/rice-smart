# rice-smart Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control — see .gitignore.
#
# All keys are optional. Missing keys just disable the corresponding
# provider (Pasadee will fall back to the next one in the chain).

# ── LLM API Keys (Multi-Model Gateway) ──────────────────────────────
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# SCB 10X Typhoon — Thai-native LLM, preferred primary provider
TYPHOON_API_KEY=

# ── Weather ────────────────────────────────────────────────────────
# Request a token from https://data.tmd.go.th
TMD_API_KEY=

# ── Firebase ───────────────────────────────────────────────────────
# Firebase is configured via google-services.json (Android) and
# GoogleService-Info.plist (iOS); no env vars needed here.

# ── HuggingFace (RAG embeddings) ───────────────────────────────────
# Used for WangchanBERTa Thai embeddings via the Inference API.
# Free tier supports up to 1k requests/day. Get a token at
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
